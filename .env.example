# ---------------------------------------------------------------------------
# VOID·SPACE — local development environment (VS-SRS-2.0 §9.4)
# Copy to .env and adjust. NEVER commit the real .env.
# `pnpm dev:up` fills CONTRACT_ADDRESS automatically after deploying the
# licensing contract to the local Anvil chain (§9.3).
#
# NOTE: every service below is addressed as `127.0.0.1`, never `localhost`.
# On a Windows host `localhost` resolves to the IPv6 loopback `::1` first, and
# the WSL port relay — not Docker — owns the forwarded port there, so the TCP
# connection is accepted and then reset. Every preview of a large model failed
# with `Could not load /ipfs/<cid>: Failed to fetch` for that reason alone.
# ---------------------------------------------------------------------------

# --- Core runtime -----------------------------------------------------------
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000

# --- PostgreSQL -------------------------------------------------------------
# DATABASE_URL          : runtime role, subject to RLS. Used by api + worker.
# PLATFORM_DATABASE_URL : platform role, privileges only on Tenant/Role tables
#                         (SuperAdmin operations, §3.5). Used by api only.
# MIGRATE_DATABASE_URL  : schema owner, used by Prisma migrations & RLS apply.
DATABASE_URL=postgresql://void_app:DevVoidApp2026@127.0.0.1:5432/voidspace?schema=public
PLATFORM_DATABASE_URL=postgresql://void_platform:void_platform_pw@127.0.0.1:5432/voidspace?schema=public
MIGRATE_DATABASE_URL=postgresql://voidspace:voidspace_pw@127.0.0.1:5432/voidspace?schema=public
POSTGRES_USER=voidspace
POSTGRES_PASSWORD=voidspace_pw
POSTGRES_DB=voidspace
POSTGRES_PORT=5432

# --- Redis (BullMQ + cache + rate limits) -----------------------------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379

# --- IPFS (Kubo, local content-addressed storage, §3.8) ---------------------
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080
IPFS_API_PORT=5001
IPFS_GATEWAY_PORT=8080

# --- Local EVM chain (Anvil / Foundry, §3.9.1) ------------------------------
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_PORT=8545
ANVIL_CHAIN_ID=31337
# Written by the deploy-contracts container after forge script --broadcast.
CONTRACT_ADDRESS=
# Root seed for per-tenant managed ("publisher") wallets (§3.9.3).
# Anvil's first pre-funded test account key — LOCAL DEVELOPMENT ONLY.
PLATFORM_SIGNER_SEED=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Auth ------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Google SSO (optional, FR-2.2) — leave blank to disable the SSO button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/v1/auth/google/callback
# Optional SIWE wallet login (FR-2.6)
SIWE_ENABLED=true
# The EIP-4361 domain/uri a signed message must match (replay protection).
SIWE_DOMAIN=localhost
SIWE_URI=https://localhost
# FR-2.3 requires Secure cookies; set to false only to browse the plain-http origin.
COOKIE_SECURE=true

# --- Web client (build-time, inlined by Next) -------------------------------
# Path the browser uses for API calls. Relative, so it works behind the edge.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Optional: a block-explorer base, e.g. https://sepolia.etherscan.io. Empty = the
# transaction hash is shown as text without a link.
NEXT_PUBLIC_CHAIN_EXPLORER_URL=

# --- Uploads (FR-3.1) -------------------------------------------------------
# Staging area for in-flight uploads before the ipfs-pin worker moves them to IPFS.
STAGING_DIR=.staging
# Optional: a hard ceiling on the staging area (bytes).
STAGING_MAX_BYTES=5368709120
# Optional: Claude model + timeout for AI enrichment (FR-7.1). Without
# ANTHROPIC_API_KEY the deterministic offline enricher is used instead.
ANTHROPIC_TIMEOUT_MS=30000

# --- Edge / TLS -------------------------------------------------------------
# nginx upstreams: use host.docker.internal:* when api/web run natively
# (`pnpm dev`), or api:4000 / web:3000 when they run inside compose.
EDGE_WEB_UPSTREAM=host.docker.internal:3000
# The edge lives in a container; these say where the app servers are.
#   containerised apps (docker compose --profile app): web:3000 / api:4000
#   native apps (pnpm dev on the host): host.docker.internal:3000 / :4000
EDGE_API_UPSTREAM=host.docker.internal:4000
EDGE_IPFS_GATEWAY_UPSTREAM=ipfs:8080
TLS_CERT_PATH=/etc/nginx/certs/void-space.crt
TLS_KEY_PATH=/etc/nginx/certs/void-space.key

# --- Optional external integrations (absent => graceful degradation, NFR-REL.1)
#
# These names are not free text: each one is read by name in `apps/api/src/env.ts` and handed to the
# adapter it configures. A value set under a different name is ignored in silence — the adapter simply
# reports itself offline forever, and nothing says why. When an adapter is added or renamed, change it
# in both places.
#
# AI enrichment (FR-7). Without a key the worker uses the deterministic
# offline enricher so the whole upload -> review -> publish flow still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# FR-6.1 Sketchfab. A single API token (`Authorization: Token …`), not an OAuth client pair.
SKETCHFAB_API_TOKEN=
# FR-6.2 Poly Pizza.
POLY_PIZZA_API_KEY=
# FR-6.4 Meshy text-to-3D.
MESHY_API_KEY=
# FR-6.3 headless Blender. Unset is a supported state: the worker records a *labelled simulation*
# with no bytes rather than failing, so the pipeline stays inspectable without the ~1 GB image.
# To run it for real, bring the optional profile up and point the worker at it:
#   docker compose --profile blender up -d blender-runner
#   BLENDER_RUNNER_URL=http://blender-runner:8090
BLENDER_RUNNER_URL=
# EoN Reality (FR-10.4). Without a URL the worker records the documented labelled simulation.
EON_API_URL=
EON_API_KEY=
# Where the public reads the pushed scene. Has a default; set it only to override the origin.
EON_PUBLIC_BASE_URL=

# --- Worker tuning (§3.10, NFR-SCAL.2) -------------------------------------
WORKER_CONCURRENCY_AI=2
WORKER_CONCURRENCY_IPFS=4
WORKER_CONCURRENCY_BLENDER=1
WORKER_CONCURRENCY_CHAIN=2
WORKER_CONCURRENCY_PUBLISH=2
WORKER_CONCURRENCY_NOTIFY=4
JOB_POLL_RATE_LIMIT_PER_MIN=120

# --- Observability ---------------------------------------------------------
LOG_LEVEL=debug
