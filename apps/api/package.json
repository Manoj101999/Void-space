{
  "name": "@void-space/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify REST API for VOID·SPACE — the single source of truth for authorization, tenancy enforcement and business rules (SRS §3.1, §6.4).",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.2.0",
    "@void-space/db": "workspace:*",
    "@void-space/types": "workspace:*",
    "bullmq": "^5.34.10",
    "fastify": "^4.29.0",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "viem": "^2.56.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
