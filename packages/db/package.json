{
  "name": "@void-space/db",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, migrations, Row-Level Security policies and seed data for VOID\u00b7SPACE (SRS \u00a75).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "node scripts/prisma-migrate.mjs migrate dev",
    "migrate:deploy": "node scripts/prisma-migrate.mjs migrate deploy",
    "migrate:create": "node scripts/prisma-migrate.mjs migrate dev --create-only",
    "rls:apply": "node scripts/apply-rls.mjs",
    "seed": "tsx src/seed-cli.ts",
    "reset": "node scripts/prisma-migrate.mjs migrate reset --force --skip-seed",
    "studio": "node scripts/prisma-migrate.mjs studio",
    "build": "prisma generate && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:glb": "tsx src/glb-cli.ts",
    "sync-catalog": "tsx src/sync-catalog-cli.ts"
  },
  "turbo": {
    "tasks": {
      "build": {
        "outputs": [
          "generated/**"
        ]
      }
    }
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@void-space/types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.10",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
